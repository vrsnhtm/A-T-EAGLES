{
  "name": "at-accounting-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing and lead-capture website for a Philippine accounting firm.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
