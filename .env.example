# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives the internal notification for every inquiry
NOTIFY_TO_EMAIL=onlineateagles@gmail.com

# Verified sender. onboarding@resend.dev only delivers to the Resend account
# owner's email; verify your own domain and update this to send to clients.
FROM_EMAIL="A&T Accounting <onboarding@resend.dev>"

# Optional: Gmail/SMTP sender for the client confirmation, needed while the
# sender is still Resend's shared test address (it only reaches the account
# owner). Create an App Password at https://myaccount.google.com/apppasswords
# after enabling 2-Step Verification, then uncomment:
# SMTP_USER=onlineateagles@gmail.com
# SMTP_PASS=your-16-character-app-password
